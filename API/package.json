{
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "bun build --compile --target=bun-windows-x64./src/index.js --outfile ./dist/api-inventario.exe",
    "build:win": "bun build --compile --target=bun-windows-x64 ./src/index.js --outfile ./dist/api-inventario.exe",
    "build:linux": "bun build --compile --target=bun-linux-x64 ./src/index.js --outfile ./dist/api-inventario",
    "build:mac": "bun build --compile --target=bun-darwin-x64 ./src/index.js --outfile ./dist/api-inventario",
    "build:all": "bun build --compile --target=bun-windows-x64 ./src/index.js --outfile ./dist/api-inventario.exe && bun build --compile --target=bun-linux-x64 ./src/index.js --outfile ./dist/api-inventario-linux && bun build --compile --target=bun-darwin-x64 ./src/index.js --outfile ./dist/api-inventario-macos"
  },
  "dependencies": {
    "bun": "^1.3.11",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongodb": "^6.3.0",
    "mysql2": "^3.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
